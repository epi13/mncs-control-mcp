# Copy to ~/.config/mncs-control-mcp/tunnel.env and chmod 600.
# Never commit the real runtime key.
CONTROL_PLANE_API_KEY=replace-me

# Required when the runtime key belongs to more than one organization or the
# tunnel control plane requires an explicit active organization context.
# Find the value in OpenAI Platform organization settings.
CONTROL_PLANE_ORGANIZATION_ID=<organization-id>
