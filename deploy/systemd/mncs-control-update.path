[Unit]
Description=Watch MNCS Control sources and owner scope grants

[Path]
PathChanged=%h/Documents/Projects/mncs-control-mcp/.git/HEAD
PathChanged=%h/Documents/Projects/mncs-control-mcp/.git/refs/heads/main
PathChanged=%h/Documents/Projects/mncs-control-mcp/.git/packed-refs
PathChanged=%h/Documents/Projects/mncs-environment/.git/HEAD
PathChanged=%h/Documents/Projects/mncs-environment/.git/refs/heads/main
PathChanged=%h/Documents/Projects/mncs-environment/.git/packed-refs
PathChanged=%h/.config/mncs-control-mcp/environment-scope-grants.toml
Unit=mncs-control-update.service

[Install]
WantedBy=default.target
