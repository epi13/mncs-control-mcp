{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mncs-control-specialist-routing-shadow/0.1",
  "title": "MNCS Control Specialist Routing Shadow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "request_identity",
    "model_identity",
    "generation_identity",
    "calibration_identity",
    "fallback_family",
    "schema_valid",
    "abstained",
    "execution_authorized",
    "policy_authoritative",
    "measurements",
    "authority"
  ],
  "properties": {
    "schema": {"const": "mncs-control-specialist-routing-shadow/0.1"},
    "status": {"enum": ["OBSERVED", "UNKNOWN"]},
    "request_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "existing_decision": {"type": "object"},
    "model_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generation_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "calibration_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposed_family": {"type": ["string", "null"]},
    "fallback_family": {"type": ["string", "null"]},
    "candidate_tool_ids": {"type": "array", "items": {"type": "string"}},
    "escalation_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "comparison": {"type": "object"},
    "schema_valid": {"type": "boolean"},
    "abstained": {"type": "boolean"},
    "execution_authorized": {"const": false},
    "policy_authoritative": {"const": true},
    "measurements": {"type": "object"},
    "authority": {"const": "policy-authoritative-existing-decision"},
    "semantics": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
